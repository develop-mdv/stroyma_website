# Django core
SECRET_KEY=replace-me-in-production
# Старые SECRET_KEY через запятую (ротация ключей, опционально)
# SECRET_KEY_FALLBACKS=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.ru
CSRF_TRUSTED_ORIGINS=https://your-domain.ru
SITE_URL=https://your-domain.ru
# URL админки (например admin/); не публикуйте в открытом виде
ADMIN_URL=admin/

# Email для уведомлений о заказах и заявках (пусто = как EMAIL_HOST_USER)
# ORDER_NOTIFY_EMAIL=orders@example.com

# PostgreSQL (локально: DB_HOST=localhost; Docker Compose: задать в docker-compose.yml как db)
DB_NAME=stroyma
DB_USER=stroyma
DB_PASSWORD=change-me-strong
DB_HOST=localhost
DB_PORT=5432

# SMTP (Яндекс)
EMAIL_HOST_USER=example@yandex.ru
EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT=20

# Redis: кеш django + сессии (cached_db), ratelimit, axes (см. stroyma/settings.py)
# Локально: redis://127.0.0.1:6379/1
# Docker Compose задаёт REDIS_URL в сервисе web (см. docker-compose.yml)
# REDIS_URL=

# Продакшен-HTTPS: Caddy принимает 80/443, Nginx и Django доступны только внутри Compose.
# Для разработки docker-compose.dev.yml задаёт DEBUG=True и HTTP на 127.0.0.1:8080.
# HTTP_PORT=8080
# Применяются только при DEBUG=False:
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000

# django-axes
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_HOURS=1

# Gunicorn (в Docker / deploy/entrypoint.sh)
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
